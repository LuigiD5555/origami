{
  "contract_id": "origami.fixed-carrier.r2",
  "version": "2.1.0-experimental",
  "status": "EXPERIMENTAL_REFERENCE_IMPLEMENTED_NATIVE_SEMANTIC_EVIDENCE_PENDING",
  "purpose": "Freeze a self-booting visual carrier with a VLM-readable semantic navigation plane while keeping deterministic exact/control recovery separate and optional for semantic questions.",
  "physical_profile": {
    "profile_id": "origami.fixed-carrier.r2.profile-2",
    "legacy_profile_readable": "origami.fixed-carrier.r2.profile-1",
    "width_px": 640,
    "height_px": 640,
    "max_png_bytes": 512000,
    "frozen_png_bytes": 8192,
    "canvas_growth_with_corpus": "FORBIDDEN",
    "pixel_model": "high-contrast semantic navigation marks plus deterministic exact/control record"
  },
  "bootstrap": {
    "T0": "plaintext semantic-first bootloader readable by generic VLMs",
    "T1": "Rosetta plus duplicated visual-presence challenge",
    "T2": "actual bounded semantic superindex projected from canonical memory",
    "T3": "dense deterministic control/exact record and auxiliary state map",
    "VERIFY": "root binding, duplicate visual challenge and exactness invariants"
  },
  "boot_text": [
    "ORIGAMI FIXED CARRIER R2",
    "THIS IMAGE IS A COMPUTATIONAL CARRIER",
    "BOOT: TEXT > PROBE > ROSETTA > T2",
    "SEMANTIC: READ T2. DO NOT DECODE BINARY",
    "EXACT: QUERY EXPAND VERIFY IF TOOLS EXIST",
    "UNKNOWN > INVENTION. FALSE_EXACT=0"
  ],
  "semantic_plane": {
    "primary_native_entry": "T2",
    "index_source": "bounded valid JSON graph hint with actual canonical top-level labels",
    "index_query_requires_binary_decode": false,
    "overview_query_requires_binary_decode": false,
    "missing_semantic_hint": "UNKNOWN_NOT_BINARY_GUESS",
    "mechanical_dependency_for_semantic_navigation": "FORBIDDEN"
  },
  "control_record": {
    "magic": "OFCR2",
    "record_bytes": 512,
    "fields": [
      "flags",
      "page_count",
      "block_count",
      "document_count",
      "object_count",
      "carrier_id_sha256",
      "store_root_sha256",
      "source_sha256",
      "tool_protocol_digest",
      "profile_digest",
      "T0_boot_digest",
      "bounded_graph_and_semantic_index_hint_256_bytes",
      "deterministic_redundancy",
      "crc32"
    ]
  },
  "exact_plane": {
    "role": "EXACT_RECOVERY_VERIFICATION_AND_CONTROL",
    "native_semantic_dependency": false,
    "may_require_decoder_or_tool": true,
    "unavailable_behavior": "NOT_VERIFIED_OR_UNKNOWN"
  },
  "tool_binding": {
    "protocol": "tlaloc.origami-tools.r2",
    "address_abi": "ohf-address.r2",
    "required_for_external_exact_corpus": true,
    "required_for_semantic_t2": false,
    "ocr_required": false,
    "binding_authority": "carrier_id + store_root_sha256 + source_sha256"
  },
  "family_roles": ["F01","F05","F09","F21","F22","F24","F25","F29","F32","F34","F39","F40","F41","F42"],
  "hard_invariants": [
    "PNG_BYTES_LE_512000",
    "PNG_BYTES_EQ_8192",
    "CANVAS_IS_640x640",
    "CANVAS_DOES_NOT_GROW_WITH_CORPUS",
    "T0_PLAINTEXT_BOOT_PRESENT",
    "DUPLICATED_VISUAL_PROBE_REQUIRED",
    "T2_CONTAINS_ACTUAL_SEMANTIC_ENTRIES",
    "SEMANTIC_NAVIGATION_NE_MECHANICAL_DECODE",
    "EXACT_PLANE_OPTIONAL_FOR_SEMANTIC_NAVIGATION",
    "NO_UNVERIFIED_BYTE_HASH_COMPRESSION_CLAIMS",
    "OCR_IS_OPTIONAL_NOT_BOOT",
    "CONTROL_PLANE_NE_SEMANTIC_PLANE",
    "ADDRESS_NE_CONTENT_ID",
    "ACTIVE_CONTEXT_NE_TOTAL_MEMORY",
    "FALSE_EXACT=0",
    "UNKNOWN_OVER_INVENTION",
    "NATIVE_VISUAL_READABILITY_NE_DETERMINISTIC_DECODE"
  ]
}
