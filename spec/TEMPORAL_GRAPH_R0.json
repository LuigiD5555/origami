    "why_did_event_happen": "T2/EVENTS -> RULES -> INPUTS",
    "replay_phase": "T2/TIMELINE -> CHECKPOINT -> SELECTIVE_TEMPORAL_UNFOLD"
  },
  "hard_invariants": [
    "T2_REMAINS_SEMANTIC_FIRST",
    "TEMPORAL_NAVIGATION_NE_GLOBAL_REPLAY",
