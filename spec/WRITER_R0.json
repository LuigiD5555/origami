{
  "contract_id": "origami.writer.r0",
  "status": "EXPERIMENTAL_REFERENCE_IMPLEMENTED",
  "visual_grammar_contract": "origami.canonical-visual-grammar.r0",
  "semantic_spine_contract": "origami.semantic-spine.r1",
  "perceptual_contract": "origami.perceptual-channels.r0",
  "native_navigation_contract": "origami.native-semantic-navigation.r0",
  "protocol_contract": "origami.protocol.r0",
  "codec_contract": "origami.codec-registry.r0",
  "capability_contract": "origami.capability-negotiation.r0",
  "purpose": "Allow a compatible model or deterministic toolchain to construct a new Origami message from source/document semantics using the active canonical profile and its declared Encoder Registry, including a useful T2 semantic superindex, instead of inventing an ad-hoc aesthetic or relying on hidden writer logic.",
  "modes": ["READ", "WRITE"],
  "write_flow": [
    "INGEST_SOURCE_OR_CANONICAL_DOCUMENT_IR",
    "DERIVE_OR_ACCEPT_SEMANTIC_IR",
    "DECLARE_VISUAL_INTENTS",
    "READ_ACTIVE_ROSETTA",
    "DISCOVER_ENCODER_REGISTRY",
    "NEGOTIATE_WRITE_CAPABILITIES",
    "SELECT_SMALLEST_SUFFICIENT_ENCODERS",
    "BIND_INTENTS_TO_CANONICAL_DIMENSIONS",
    "GENERATE_PROGRAM_AND_ACTUAL_T2_SEMANTIC_INDEX",
    "GENERATE_MEMORY_AND_VERIFICATION",
    "EMIT_CONSTRUCTION_IR",
    "COMPILE_CANONICAL_CARRIER_WHEN_AVAILABLE",
    "SELF_VERIFY",
    "ROUNDTRIP_SEMANTIC_CHECK"
  ],
  "source_policy": {
    "pdf_to_png_screenshot_forbidden": true,
    "raw_text_poster_forbidden": true,
    "source_may_be_pdf_image_text_or_document_ir": true,
    "semantic_extraction_may_use_external_development_or_ingestion_system": true,
    "final_visual_compilation_authority": "ORIGAMI_CANONICAL_PROFILE"
  },
  "visual_intent_classes": ["IDENTITY","HIERARCHY","RELATION","DEPENDENCY","SCOPE","IMPORTANCE","STATE","UNCERTAINTY","EVIDENCE","VERIFICATION","ADDRESSABILITY","TEMPORAL_ORDER","REDUNDANCY","ROUTING"],
  "construction_spec": {
    "required": ["schema","profile_id","source_identity","semantic_commitment","visual_intents","rosetta","encoder_selection","sections","verification_plan"],
    "profile_id": "origami.canonical-aesthetic.r0",
    "carrier_local_style_override": false,
    "t2_requirement": "BOUNDED_ACTUAL_SEMANTIC_ENTRY_POINTS_FOR_COMMON_NATIVE_QUERIES",
    "generic_category_only_t2_forbidden": true
  },
  "encoder_registry": {
    "semantic_core": ["E0","E1","E2"],
    "semantic_extended": ["E3","E4","E5","E6"],
    "exact_control": ["Q0","Q1","Q2","Q3","Q4","Q5"],
    "semantic_encoder_must_not_hide_exact_dependency": true,
    "undeclared_external_encoder_forbidden": true,
    "first_mandatory_write_gate": "E2_ENCODE_SUPERINDEX"
  },
  "rosetta_generation": {
    "must_include_profile_id": true,
    "must_include_profile_version": true,
    "must_include_active_dimensions": true,
    "must_map_visual_primitives_to_semantic_roles": true,
    "must_bind_semantic_roles_to_decoder_ids": true,
    "must_bind_semantic_roles_to_encoder_ids": true,
    "must_include_capability_requirements_and_fallbacks": true,
    "must_include_any_experimental_extension": true,
    "promoted_perceptual_binding_must_include_reveal_procedure": true,
    "reveal_procedure_fields": ["operation","required_inputs","observation_condition","trajectory_if_needed","integration_window_if_needed","fallback_if_any","failure_state"],
    "must_not_depend_on_private_prompt_state": true
  },
  "native_semantic_write_rule": {
    "index_query_target": "T2",
    "index_encoder": "E2",
    "index_decoder_pair": "S2",
    "t2_must_prioritize_actual_semantic_entries": true,
    "semantic_index_must_not_require_exact_plane_decode": true,
    "semantic_index_write_must_not_require_exact_plane_encode": true,
    "bounded_top_level_index_allowed": true,
    "missing_index_behavior": "UNKNOWN_NOT_BINARY_FALLBACK"
  },
  "perceptual_write_rule": {
    "static_primitive_reveal_optional": true,
    "interference_depth_temporal_emergent_reveal_required_when_profile_promotes_channel": true,
    "unavailable_reveal_condition": "UNKNOWN",
    "examples": ["MOIRE","PHASE_SHIFT","STEREO_BIND","PARALLAX_RESOLVE","KINETIC_REVEAL","TEMPORAL_INTEGRATE"]
  },
  "model_behavior": {
    "if_compiler_available": "EMIT_CONSTRUCTION_SPEC_AND_USE_COMPILER",
    "if_compiler_unavailable": "EMIT_CONSTRUCTION_SPEC_ONLY_AND_DO_NOT_CLAIM_VALID_CARRIER",
    "if_encoder_capability_unavailable": "USE_DECLARED_FALLBACK_OR_CONSTRUCTION_SPEC_ONLY",
    "may_directly_paint_arbitrary_png": false,
    "may_change_canonical_aesthetic_without_profile_promotion": false
  },
  "roundtrip_gate": {
    "required": true,
    "equation": "DECODE(ENCODE(SEMANTIC_IR)) ~= SEMANTIC_IR",
    "exact_parts": "IDENTITY_ADDRESS_HASH_AND_VERIFICATION_FIELDS_REQUIRE_EXACT_MATCH_WHEN_PRESENT",
    "semantic_parts": "SEMANTIC_EQUIVALENCE_UNDER_DECLARED_CANONICALIZATION",
    "native_navigation_parts": "S2(E2(INDEX)) must recover the declared bounded semantic entry points without exact/control-plane codecs",
    "perceptual_parts": "A promoted non-static channel must reproduce its declared semantic result under its declared observation/reveal contract; inability to satisfy the reveal condition is UNKNOWN rather than absence.",
    "failure_state": "INVALID_CARRIER"
  },
  "hard_invariants": [
    "WRITE_USES_CANONICAL_VISUAL_PROFILE",
    "ROSETTA_IS_REQUIRED_IN_READ_AND_WRITE",
    "ROSETTA_DECLARES_ENCODING_SEMANTICS",
    "MODEL_DOES_NOT_DEFINE_A_NEW_AESTHETIC_PER_DOCUMENT",
    "T2_CONTAINS_ACTUAL_SEMANTIC_ENTRIES",
    "SEMANTIC_INDEX_NE_EXACT_PLANE_DECODE",
    "SEMANTIC_INDEX_WRITE_NE_EXACT_PLANE_ENCODE",
    "NO_UNDECLARED_EXTERNAL_ENCODER_DEPENDENCY",
    "PROMOTED_PERCEPTUAL_CHANNEL_REQUIRES_REVEAL_PROCEDURE",
    "FAILED_REVEAL_NE_SEMANTIC_ABSENCE",
    "SOURCE_SCREENSHOT_NE_ORIGAMI",
    "CONSTRUCTION_SPEC_PRECEDES_COMPILATION",
    "COMPILER_NOT_MODEL_PIXELS_IS_CARRIER_AUTHORITY",
    "ROUNDTRIP_REQUIRED",
    "FALSE_EXACT=0"
  ],
  "reference_runtime": "internal/writer",
  "reference_codec_runtime": "internal/codec",
  "reference_cli": "cmd/origami-write-plan"
}